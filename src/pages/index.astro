---
import SlideShow from "@components/SlideShow.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title=" ">
  <div class="flex flex-col h-full">
    <div class="flex-none">
      <p class="text-sm leading-tight text-justify mb-8">
        We develop computational and machine learning methods to understand cancer in its tissue context. 
        By integrating proteomics, genomics, spatial omics, tissue imaging and clinical data, 
        we map how tumor cells and their microenvironment are organized and 
        how that organization shapes disease progression and response to therapy. 
        Our work centers on gynecologic cancers and small cell lung cancer, and the role of retrotransposition in cancer, 
        with the aim of translating molecular insight into precision medicine.
      </p>
    </div>

    <div class="grow overflow-hidden">
      <SlideShow />
    </div>
  </div>
</Layout>
